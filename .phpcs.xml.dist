<?xml version="1.0"?>
<ruleset name="My Custom Plugin Coding Standards">
    <description>WPCS ruleset for a namespaced, Composer/PSR-4 based WordPress plugin.</description>

    <file>.</file>
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="./"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP"/>

    <config name="minimum_supported_wp_version" value="6.5"/>

    <rule ref="WordPress">
        <!-- PSR-4 autoloading requires filename === class name; incompatible
             with WPCS's legacy class-{name}.php convention by design. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Namespaced class methods aren't in the global scope, so WP's
             snake_case global-function convention doesn't apply; PSR-1/2
             camelCase methods are standard here. -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
    </rule>

    <!-- Short array syntax [] is standard PSR-12 style for PHP 5.4+; the
         legacy array() longhand isn't warranted for PHP 8.1 target code. -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
	<exclude-pattern>/tests/*</exclude-pattern>	    
        <properties>
            <property name="prefixes" type="array">
                <element value="mycustomplugin"/>
                <element value="MyCustomPlugin"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="my-custom-plugin"/>
            </property>
        </properties>
    </rule>
</ruleset>
